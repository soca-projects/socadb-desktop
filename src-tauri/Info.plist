<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleLocalizations</key>
    <array>
        <string>en</string>
        <string>fr</string>
    </array>
    <key>SUFeedURL</key>
    <string>https://github.com/soca-projects/socadb-desktop/releases/latest/download/appcast.xml</string>
    <key>SUPublicEDKey</key>
    <string>JFF5bCjXSk4cwk7i3tHOHwaCp1yMercU7osKZ9x8LEc=</string>
    <!-- The app schedules checks and downloads only when its settings allow or
         the user agrees. Sparkle disallows automatic downloads while its own
         checks are off, unless SUAllowsAutomaticUpdates is set. -->
    <key>SUEnableAutomaticChecks</key>
    <false/>
    <key>SUAutomaticallyUpdate</key>
    <false/>
    <key>SUAllowsAutomaticUpdates</key>
    <true/>
    <!-- Declared here rather than in fileAssociations: Tauri has no field for the
         type's icon, and this key replaces the declaration Tauri would generate. -->
    <key>UTExportedTypeDeclarations</key>
    <array>
        <dict>
            <key>UTTypeIdentifier</key>
            <string>com.socadb.schema</string>
            <key>UTTypeDescription</key>
            <string>SocaDB schema</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.json</string>
            </array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>soca</string>
                </array>
                <key>public.mime-type</key>
                <string>application/x-socadb</string>
            </dict>
            <key>UTTypeIcons</key>
            <dict>
                <key>UTTypeIconBadgeName</key>
                <string>icon</string>
                <key>UTTypeIconText</key>
                <string>soca</string>
            </dict>
        </dict>
    </array>
</dict>
</plist>
