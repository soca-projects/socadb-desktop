{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions for SocaDB",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:menu:default",
    "core:window:allow-start-dragging",
    "core:window:allow-close",
    "core:window:allow-set-theme",
    "core:app:allow-default-window-icon",
    "log:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-write-file",
    "fs:allow-exists",
    "opener:default",
    "updater:default",
    "process:allow-restart",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$HOME/.claude.json" },
        { "path": "$DATA/Claude/**" },
        { "path": "$LOCALDATA/Packages/Claude_*/LocalCache/Roaming/Claude/**" },
        { "path": "$HOME/.socadb/**" }
      ]
    }
  ]
}
